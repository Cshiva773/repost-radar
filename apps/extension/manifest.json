{
  "manifest_version": 3,
  "name": "Repost Radar",
  "version": "0.1.0",
  "description": "Check an image against your Repost Radar originals, and file approved notices.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://i.redd.it/*",
    "https://preview.redd.it/*",
    "https://external-preview.redd.it/*",
    "https://cdn.bsky.app/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_icon": { "32": "icons/icon-32.png", "128": "icons/icon-128.png" } },
  "options_page": "options.html",
  "icons": { "32": "icons/icon-32.png", "128": "icons/icon-128.png" }
}
