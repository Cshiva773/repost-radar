# Copy to .env before `make up`. Every value here is a local-only default.

# Postgres
POSTGRES_USER=repost_radar
POSTGRES_PASSWORD=repost_radar_local
POSTGRES_DB=repost_radar
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# S3-compatible object storage (SeaweedFS locally). Keys must match infra/seaweedfs/s3.json
S3_ACCESS_KEY=repost_radar
S3_SECRET_KEY=repost_radar_local
S3_BUCKET=repost-radar
S3_PORT=8333

# API and review UI (open http://localhost:3000)
API_PORT=8080
WEB_PORT=3000
LOG_LEVEL=info

# The operator account (the only one that can see /metrics). Created on first start; change the password here
# and restart the API to rotate it (old sessions are signed out). At least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-local-only
# true: anyone can sign up on the sign-in page and gets their own private space (originals, sources, matches)
SIGNUP_ENABLED=true
SESSION_TTL_HOURS=24
# true when the app is served over HTTPS
COOKIE_SECURE=false
# Proxies in front of the API, so sign-in and sign-up limits count each visitor: 1 locally (nginx),
# 2 on a live install (Caddy + nginx; docker-compose.prod.yml sets it)
TRUST_PROXY_HOPS=1

# Live install only (docs/DEPLOYING.md; scripts/server-setup.sh writes these): the public address Caddy
# serves over HTTPS, and the compose files to use
# SITE_ADDRESS=radar.example.com
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Connection strings used by tools running on the host (migrate, ping)
DATABASE_URL=postgres://repost_radar:repost_radar_local@localhost:5432/repost_radar
REDIS_URL=redis://localhost:6379

# Crawler
CRAWLER_TICK_SECONDS=60
# Unmatched crawled images are deleted after this many days
RETENTION_DAYS=7
# Posts behind open matches are re-checked this often; a copy taken down closes its match as removed
SOURCE_RECHECK_HOURS=6

# Matcher: >= REVIEW_THRESHOLD goes to the review queue; between the two is stored as suppressed
REVIEW_THRESHOLD=0.70
SUPPRESSED_FLOOR=0.60

# Platforms the crawler watches (comma-separated). Each adapter reads its own settings below.
# Bluesky is the live platform (public AppView, no account). Reddit runs against the local fixture
# feed unless you have approved Reddit API credentials.
ENABLED_PLATFORMS=bluesky,reddit

# Reddit (phase 2) — fill in after registering a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="repost-radar/0.1 by u/your_username"
# fixture = local fake-reddit service (no credentials); live = real Reddit via the app above
REDDIT_MODE=fixture

# Bluesky: works without credentials (public AppView). Targets are "#hashtag" or "@handle".
# Optional app password (Settings > App passwords) routes requests through your PDS instead.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_USER_AGENT="repost-radar/0.1 (https://github.com/Cshiva773/repost-radar)"
# Images from posts labelled porn/sexual/nudity/graphic-media are skipped unless true
BLUESKY_INCLUDE_ADULT_CONTENT=false
