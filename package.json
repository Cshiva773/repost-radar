{
  "name": "repost-radar",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "migrate": "pnpm --filter @repost-radar/db migrate",
    "ping": "pnpm --filter @repost-radar/api ping",
    "seed": "echo \"seed: not implemented until phase 1\"",
    "eval": "echo \"eval: not implemented until phase 3\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm run test:py",
    "test:py": "cd workers/fingerprint && uv run --frozen pytest -q"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
